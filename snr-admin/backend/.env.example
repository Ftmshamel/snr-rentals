# ── Data source ────────────────────────────────────────────────────────────────
# firebase (default) — Firestore only. Never connects to MongoDB or Supabase.
# supabase / mongodb — legacy stores holding the pre-Firebase real data.
DATASOURCE=firebase

# ── Firebase (Firestore) ───────────────────────────────────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private key.
# Either paste the whole JSON on one line:
FIREBASE_SERVICE_ACCOUNT=
# …or the three fields separately (keep the \n sequences in the key):
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Auth ───────────────────────────────────────────────────────────────────────
# Token given to the owner login; needed for owner-only writes (the catalogue).
# Set a long random value in production.
OWNER_TOKEN=

# ── Lalamove API (optional — without it, staff book Lalamove by hand) ─────────────
# Partner Portal → Developers. Sandbox keys are free; production charges the wallet.
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_ENV=sandbox
# The shop (pick-up for deliveries, drop-off for returns). Coordinates are required.
SHOP_ADDRESS=
SHOP_LAT=
SHOP_LNG=

# ── Legacy (DATASOURCE=supabase / mongodb only) ────────────────────────────────
# MongoDB Atlas connection string (SRV), e.g. mongodb+srv://USER:PASS@cluster...
# MONGODB_URI=
# MONGODB_DB=snr_rentals
# MONGODB_COLLECTION=form_submissions
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
